{
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Headless multi-chain bridge: dApps talk to the agent wallet daemon. No popups.",
  "host_permissions": [],
  "manifest_version": 3,
  "name": "SuperAgentic Wallet Bridge",
  "permissions": [],
  "version": "1.1.3",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "provider.js",
        "elysium_provider.js",
        "solana_provider.js",
        "multichain_provider.js"
      ]
    }
  ]
}