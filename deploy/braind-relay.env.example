# Copy to /etc/braind-relay.env, chmod 600, owned by root. Generate keys with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_AGENT_KEY=CHANGE_ME_agent_key_for_muse
RELAY_PULLER_KEY=CHANGE_ME_different_key_for_the_signer_only
RELAY_BIND=127.0.0.1
RELAY_PORT=18930
RELAY_CHAINS=sepolia,base-sepolia
RELAY_MAX_VALUE_ETHER=0.01
RELAY_RATE_PER_MIN=10
RELAY_MAX_PENDING=20
RELAY_TTL_SECONDS=3600
RELAY_PUBLIC_URL=https://relay.example.com
